<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.zakuro.android" android:versionCode="10" android:versionName="0.1.9">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00403000" android:required="true" />
    <application android:label="Zakuroishi" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:logo="@drawable/brand_logo" android:allowBackup="false" android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.NoActionBar" android:hasCode="true">
        <profileable android:shell="true" />
        <activity android:name=".Launcher" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FrontendLaunch" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zakuro" android:host="game" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.zkr" />
            </intent-filter>
        </activity>
        <receiver android:name=".DebugSettings" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name=".Game" android:exported="false" android:launchMode="singleTask" android:process=":game" android:screenOrientation="sensorLandscape" android:configChanges="orientation|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" >
            <meta-data android:name="android.app.lib_name" android:value="zakuro_android" />
        </activity>
    </application>
</manifest>
